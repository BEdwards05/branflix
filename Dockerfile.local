FROM node:22.23.4-alpine3.23@sha256:206878a60dc7014193f418ab9259b6110c15fbd514b3044a267be706509944e4

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

COPY . /app
WORKDIR /app

RUN pnpm install

# Bind-mounted source plus an anonymous node_modules volume can lag behind
# package.json. Reinstall on start so new deps (e.g. lru-cache) are present.
CMD pnpm install && pnpm dev
